{
  "name": "dsh-screen-vision-win",
  "version": "1.1.5",
  "description": "AI 连续视觉（Windows 版）：把桌屏幕面的动态变化（滚动/切窗/弹窗/焦点/视频/动画）持续转换为带时间戳的结构化 JSON 事件流与自然语言摘要，供 dsh agent 直接消费。零外部依赖：纯 node: 内建 + PowerShell 调 UI Automation 与 GDI+。",
  "type": "module",
  "main": "lib/index.js",
  "license": "MIT",
  "author": "backlit125",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/backlit125/dsh-screen-vision-win.git"
  },
  "bugs": {
    "url": "https://github.com/backlit125/dsh-screen-vision-win/issues"
  },
  "homepage": "https://github.com/backlit125/dsh-screen-vision-win#readme",
  "engines": {
    "node": ">=22.6"
  },
  "os": [
    "win32"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "screen-vision",
    "continuous-vision",
    "windows",
    "ui-automation",
    "uiautomation",
    "gdi",
    "screenshot",
    "accessibility",
    "event-stream",
    "visual-perception",
    "scroll-detection",
    "video-detection"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "test"
  ],
  "scripts": {
    "test": "node test/run.mjs",
    "check": "node --check lib/index.js && node --check lib/engine.js && node --check lib/capture.js"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  }
}
